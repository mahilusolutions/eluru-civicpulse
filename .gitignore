# Track only CivicPulse app + Eluru voter PDFs
/*
!/.gitignore
!/README.md
!/deploy/
!/civicpulse/
!/civicpulse-backend/
!/voter_data_eluru/
!/eluru_voters_data_ocr_extraction/

# OCR app runtime data (keep .gitkeep only)
eluru_voters_data_ocr_extraction/uploaded_files/*
!eluru_voters_data_ocr_extraction/uploaded_files/.gitkeep
eluru_voters_data_ocr_extraction/extracted_ocr_data/*
!eluru_voters_data_ocr_extraction/extracted_ocr_data/.gitkeep
eluru_voters_data_ocr_extraction/code/node_modules/

# Secrets / local machine (never commit)
server_credentails.txt
**/server_credentails.txt
**/.env
**/.env.*
!**/.env.example

# Dependencies & build
**/node_modules/
**/build/
**/dist/
**/.cache/

# Backend local runtime data
civicpulse-backend/data/*.sqlite
civicpulse-backend/data/*.sqlite-*
civicpulse-backend/data/uploads/*
!civicpulse-backend/data/uploads/.gitkeep
civicpulse-backend/data/json/*
!civicpulse-backend/data/json/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-error.log*
