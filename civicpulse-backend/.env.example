PORT=4000

# One database, two schemas: public (app) + voterdb (OCR extraction)
# Local Postgres, or SSH tunnel to VPS:
#   ssh -L 5432:127.0.0.1:5432 root@YOUR_VPS_IP
DATABASE_URL="postgresql://civicpulse:CHANGE_ME@127.0.0.1:5432/civicpulse"

# Production (about 500-1000 users)
# Pool size: add to DATABASE_URL, e.g. ...@host:5432/civicpulse?connection_limit=20&pool_timeout=20
# Only these sites may call the API (comma separated). Leave empty for local development.
CORS_ORIGINS="https://eluru.mahilusolutions.com"
# Requests per minute per IP. Offices and mobile networks share IPs, so keep this generous.
RATE_LIMIT_PER_MIN=600
