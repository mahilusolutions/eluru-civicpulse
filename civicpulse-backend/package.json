{
  "name": "civicpulse-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CivicPulse API — Express + SQLite + PDF ingest/OCR for Eluru rolls",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "ingest:pdfs": "node scripts/bulkIngest.js",
    "ocr:all": "node scripts/ocrAll.js",
    "ocr:part": "node scripts/ocrAll.js --part=1",
    "ocr:clear-demo": "node scripts/clearDemo.js",
    "db:show": "node scripts/showDb.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
