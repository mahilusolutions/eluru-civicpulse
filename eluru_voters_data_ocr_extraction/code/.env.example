PORT=2000
OCR_PAGE_WORKERS=3
OCR_DPI=160
# 0 = DB-only (production). 1 = also write JSON/TXT backups
OCR_SAVE_DISK=0
# Behind nginx at http://HOST/ocr/
OCR_PUBLIC_BASE=/ocr
# Same Postgres as CivicPulse — writes into voterdb schema
DATABASE_URL=postgresql://civicpulse:CHANGE_ME@127.0.0.1:5432/civicpulse
